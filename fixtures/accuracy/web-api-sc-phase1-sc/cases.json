{
 "cases": [
  {
   "id": "sc001p1-neg-examples-tree",
   "rule": "SEC-SC-001",
   "kind": "negative",
   "note": "manifest under examples/ is not a deployed app",
   "files": {
    "examples/demo-app/package.json": "{\"name\":\"app\",\"dependencies\":{\"express\":\"^4.0.0\"},\"scripts\":{\"start\":\"node server.js\"}}"
   }
  },
  {
   "id": "sc001p1-neg-vendored-third-party",
   "rule": "SEC-SC-001",
   "kind": "negative",
   "note": "third_party / vendored trees",
   "files": {
    "third_party/lib/package.json": "{\"name\":\"app\",\"dependencies\":{\"express\":\"^4.0.0\"}}",
    "vendored/x/Gemfile": "source 'x'\ngem 'rails'\n"
   }
  },
  {
   "id": "sc001p1-neg-docs-and-test-trees",
   "rule": "SEC-SC-001",
   "kind": "negative",
   "note": "docs and tests trees",
   "files": {
    "docs/site/package.json": "{\"name\":\"app\",\"dependencies\":{\"express\":\"^4.0.0\"}}",
    "tests/e2e/app/package.json": "{\"name\":\"app\",\"dependencies\":{\"express\":\"^4.0.0\"}}",
    "fixtures/node/composer.json": "{\"require\":{\"a/b\":\"^1\"}}"
   }
  },
  {
   "id": "sc001p1-neg-peer-dependency-library",
   "rule": "SEC-SC-001",
   "kind": "negative",
   "note": "library declaring peerDependencies, no start",
   "files": {
    "package.json": "{\"name\":\"plugin\",\"version\":\"1.0.0\",\"peerDependencies\":{\"react\":\"^18\"},\"dependencies\":{\"x\":\"^1\"}}"
   }
  },
  {
   "id": "sc001p1-neg-poetry-library",
   "rule": "SEC-SC-001",
   "kind": "negative",
   "note": "poetry library with classifiers",
   "files": {
    "pyproject.toml": "[tool.poetry]\nname=\"lib\"\nclassifiers=[\"License :: OSI Approved\"]\n"
   }
  },
  {
   "id": "sc001p1-neg-pipfile-with-setup-py",
   "rule": "SEC-SC-001",
   "kind": "negative",
   "note": "Pipfile dev env for installable lib",
   "files": {
    "Pipfile": "[packages]\nrequests='*'\n",
    "setup.py": "from setuptools import setup\nsetup()\n"
   }
  },
  {
   "id": "sc001p1-pos-root-app-start-script",
   "rule": "SEC-SC-001",
   "kind": "positive",
   "note": "root app with start script and no lockfile",
   "files": {
    "package.json": "{\"name\":\"app\",\"dependencies\":{\"express\":\"^4.0.0\"},\"scripts\":{\"start\":\"node server.js\"}}"
   },
   "expect": [
    [
     "package.json",
     1
    ]
   ]
  },
  {
   "id": "sc001p1-pos-service-named-like-example-file",
   "rule": "SEC-SC-001",
   "kind": "positive",
   "note": "services/ tree (not an excluded dir) still flagged; example-api is a name, not a directory segment",
   "files": {
    "services/example-api/package.json": "{\"name\":\"app\",\"dependencies\":{\"express\":\"^4.0.0\"},\"scripts\":{\"start\":\"node server.js\"}}"
   },
   "expect": [
    [
     "services/example-api/package.json",
     1
    ]
   ]
  },
  {
   "id": "sc001p1-pos-poetry-app-package-mode-false",
   "rule": "SEC-SC-001",
   "kind": "positive",
   "note": "poetry app (package-mode false) with keywords still flagged",
   "files": {
    "pyproject.toml": "[tool.poetry]\nname=\"svc\"\npackage-mode = false\nkeywords=[\"x\"]\n"
   },
   "expect": [
    [
     "pyproject.toml",
     1
    ]
   ]
  },
  {
   "id": "sc001p1-pos-pipfile-app",
   "rule": "SEC-SC-001",
   "kind": "positive",
   "note": "Pipfile without setup.py is an app",
   "files": {
    "svc/Pipfile": "[packages]\nflask='*'\n",
    "svc/app.py": "x=1\n"
   },
   "expect": [
    [
     "svc/Pipfile",
     1
    ]
   ]
  },
  {
